{
    "name": "@mimi-os/plugins",
    "version": "0.1.0",
    "description": "mimi-os plugins: packs an agent mounts with runAgent({ packs }): memory, wiki, crons",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Mimi-agent-os/plugins.git"
    },
    "homepage": "https://github.com/Mimi-agent-os/plugins",
    "bugs": "https://github.com/Mimi-agent-os/plugins/issues",
    "type": "module",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm run clean && tsc -p tsconfig.build.json",
        "check": "tsc",
        "test": "node --test \"src/**/*.test.ts\"",
        "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
    },
    "dependencies": {
        "@mimi-os/sdk": "link:../sdk",
        "@mimi-os/protocol": "link:../protocol"
    },
    "devDependencies": {
        "@types/node": "^25.6.2",
        "typescript": "6.0.3"
    },
    "packageManager": "pnpm@10.34.5",
    "publishConfig": {
        "access": "public"
    }
}
